# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=game
DB_USER=postgres
DB_PASSWORD=root
DATABASE_URL=postgresql://postgres:root@localhost:5432/game

# Application ports
PORT=3001
REACT_APP_PORT=80

# API URL для клиента
REACT_APP_API_URL=https://localhost:3001

# Environment
NODE_ENV=development

# HTTPS настройки для React dev server
HTTPS=true
SSL_CRT_FILE=ssl/culty.ru.crt
SSL_KEY_FILE=ssl/culty.ru.key

# Security
JWT_SECRET=your_jwt_secret_here_change_in_production
SESSION_SECRET=your_session_secret_here_change_in_production

# Development settings for hot reload
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true
GENERATE_SOURCEMAP=false
SKIP_PREFLIGHT_CHECK=true
FAST_REFRESH=true

# Disable some checks for development
CI=false