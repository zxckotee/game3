# Production Environment Variables for culty.ru
# Скопируйте этот файл в .env.production и настройте значения

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=game
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# Application Configuration
NODE_ENV=production
PORT=3001
REACT_APP_PORT=3000

# HTTPS URLs for production
REACT_APP_API_URL=https://culty.ru
REACT_APP_BASE_URL=https://culty.ru

# Security Configuration (ОБЯЗАТЕЛЬНО ИЗМЕНИТЕ!)
JWT_SECRET=CHANGE_THIS_TO_VERY_SECURE_JWT_SECRET_MIN_32_CHARS
SESSION_SECRET=CHANGE_THIS_TO_VERY_SECURE_SESSION_SECRET_MIN_32_CHARS

# Let's Encrypt Configuration
CERTBOT_EMAIL=admin@culty.ru

# Database URL for migrations
DATABASE_URL=postgresql://postgres:CHANGE_THIS_TO_SECURE_PASSWORD@postgres:5432/game

# Application Features
USE_DATABASE=true
USE_MERCHANT_FILES=true

# Locale
LC_ALL=C.UTF-8

# Production optimizations
CI=false
GENERATE_SOURCEMAP=false

# Logging
LOG_LEVEL=info