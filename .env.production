# Production Environment Variables for culty.ru

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=game
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here

# Application Configuration
NODE_ENV=production
PORT=3001
REACT_APP_PORT=3000

# HTTPS URLs for production
REACT_APP_API_URL=https://culty.ru
REACT_APP_BASE_URL=https://culty.ru

# Security Configuration
JWT_SECRET=your_very_secure_jwt_secret_here_min_32_chars
SESSION_SECRET=your_very_secure_session_secret_here_min_32_chars

# Let's Encrypt Configuration
CERTBOT_EMAIL=admin@culty.ru

# Database URL for migrations
DATABASE_URL=postgresql://postgres:your_secure_db_password_here@postgres:5432/game

# Application Features
USE_DATABASE=true
USE_MERCHANT_FILES=true

# Locale
LC_ALL=C.UTF-8

# Production optimizations
CI=false
GENERATE_SOURCEMAP=false

# Logging
LOG_LEVEL=info