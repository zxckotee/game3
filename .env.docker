# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=game
DB_USER=postgres
DB_PASSWORD=root
DATABASE_URL=postgresql://postgres:root@postgres:5432/game

# Application ports
PORT=3001
REACT_APP_PORT=80

# API URL для клиента (через Nginx HTTPS)
REACT_APP_API_URL=https://culty.ru:3001

# Environment
NODE_ENV=production

# НЕ используем HTTPS для приложения в Docker - только Nginx обрабатывает HTTPS
# HTTPS=false
# SSL_CRT_FILE не устанавливаем
# SSL_KEY_FILE не устанавливаем

# Security
JWT_SECRET=production_jwt_secret_change_this
SESSION_SECRET=production_session_secret_change_this

# Development settings for hot reload (отключены для продакшена)
CHOKIDAR_USEPOLLING=false
WATCHPACK_POLLING=false
GENERATE_SOURCEMAP=false
SKIP_PREFLIGHT_CHECK=true
FAST_REFRESH=false

# Production settings
CI=true
USE_DATABASE=true
USE_MERCHANT_FILES=true
LC-ALL=C.UTF-8